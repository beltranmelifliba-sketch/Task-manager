{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-xl mx-auto">

<h1 class="text-2xl mb-4">Edit Task</h1>

<form method="post">
    <input name="title" value="{{ task.title }}" class="border p-2 w-full mb-2">

    <textarea name="description" class="border p-2 w-full mb-2">{{ task.description }}</textarea>

    <select name="status" class="border p-2 w-full mb-2">
        <option value="pending" {{ task.status == 'pending' ? 'selected' : '' }}>Pending</option>
        <option value="in_progress" {{ task.status == 'in_progress' ? 'selected' : '' }}>In Progress</option>
        <option value="done" {{ task.status == 'done' ? 'selected' : '' }}>Done</option>
    </select>

    <button class="bg-green-500 text-white px-4 py-2">Update</button>
</form>

</div>
{% endblock %}