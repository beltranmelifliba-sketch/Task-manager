{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-xl mx-auto">

<h1 class="text-2xl mb-4">Add Task</h1>

<form method="post">
    <input name="title" placeholder="Title" class="border p-2 w-full mb-2" required>

    <textarea name="description" placeholder="Description" class="border p-2 w-full mb-2"></textarea>

    <button class="bg-blue-500 text-white px-4 py-2">Save</button>
</form>

</div>
{% endblock %}